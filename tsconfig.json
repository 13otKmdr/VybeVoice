{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"paths": {
			"@voice-orchestrator/core": ["./packages/core/src/index.ts"],
			"@voice-orchestrator/core/*": ["./packages/core/src/*"],
			"@voice-orchestrator/realtime": ["./packages/realtime/src/index.ts"],
			"@voice-orchestrator/realtime/*": ["./packages/realtime/src/*"]
		}
	},
	"include": ["packages/*/src/**/*"],
	"exclude": ["**/dist/**", "**/node_modules/**"]
}
